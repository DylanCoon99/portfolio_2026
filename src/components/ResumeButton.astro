---
interface Props {
  class?: string;
}

const { class: className = "px-6 py-3" } = Astro.props;
---

<a
  href="/dylan_coon_resume.pdf"
  download="Dylan_Coon_Resume.pdf"
  class:list={[
    "inline-flex items-center gap-2 rounded-lg text-sm font-medium border border-[var(--color-border)] text-[var(--color-text-secondary)] bg-[var(--color-surface)] hover:border-[var(--color-accent)]/40 hover:text-[var(--color-text)] hover:shadow-[0_0_20px_var(--color-accent-glow)] transition-all",
    className,
  ]}
>
  <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" />
    <polyline points="7 10 12 15 17 10" />
    <line x1="12" y1="15" x2="12" y2="3" />
  </svg>
  Resume
</a>
