---
import TagList from "./TagList.astro";

interface Props {
  title: string;
  description: string;
  tags: string[];
  image?: string;
  github?: string;
  status: "completed" | "in-progress";
}

const { title, description, tags, image, github, status } = Astro.props;
---

<div class="glow-card rounded-xl border border-[var(--color-border)] bg-[var(--color-surface)] overflow-hidden">
  {image && (
    <img
      src={image}
      alt={title}
      class="w-full h-44 object-cover border-b border-[var(--color-border)]"
    />
  )}
  <div class="p-5">
    <div class="flex items-center gap-3 mb-2">
      <h3 class="text-[var(--color-text)] font-semibold">{title}</h3>
      <span class:list={[
        "text-xs font-medium px-2 py-0.5 rounded-full shrink-0",
        status === "completed"
          ? "bg-emerald-500/10 text-emerald-400 border border-emerald-500/20"
          : "bg-amber-500/10 text-amber-400 border border-amber-500/20"
      ]}>
        {status === "completed" ? "Completed" : "In Progress"}
      </span>
    </div>
    <p class="text-sm text-[var(--color-text-muted)] mb-4 leading-relaxed">
      {description}
    </p>
    <div class="flex items-center justify-between gap-4">
      <TagList tags={tags} />
      {github && (
        <a
          href={`https://github.com/${github}`}
          target="_blank"
          rel="noopener"
          class="github-btn text-xs shrink-0"
        >
          <svg viewBox="0 0 16 16" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
          </svg>
          View Source
        </a>
      )}
    </div>
  </div>
</div>
