---
interface Props {
  tags: string[];
}

const { tags } = Astro.props;
---

<div class="flex flex-wrap gap-2">
  {tags.map((tag) => (
    <span class="text-xs px-2.5 py-1 rounded-full border border-[var(--color-accent)]/20 bg-[var(--color-accent)]/8 text-[var(--color-accent-light)] font-medium">
      {tag}
    </span>
  ))}
</div>
