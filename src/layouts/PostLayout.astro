---
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";

interface Props {
  title: string;
  description: string;
  date: Date;
  tags: string[];
  image?: string;
  github?: string;
}

const { title, description, date, tags, image, github } = Astro.props;
const formattedDate = date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout title={title} description={description} image={image}>
  <article class="max-w-3xl mx-auto px-6 py-16 relative">
    <!-- Background glow -->
    <div class="absolute -top-20 left-1/2 -translate-x-1/2 w-96 h-48 bg-[var(--color-accent)]/6 rounded-full blur-3xl pointer-events-none"></div>

    <header class="mb-12 relative">
      <div class="flex items-center gap-4 mb-4">
        <p class="text-sm text-[var(--color-text-muted)]">{formattedDate}</p>
        {github && (
          <a
            href={`https://github.com/${github}`}
            target="_blank"
            rel="noopener"
            class="github-btn"
          >
            <svg viewBox="0 0 16 16" aria-hidden="true">
              <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            View Source
          </a>
        )}
      </div>
      <h1 class="text-3xl sm:text-4xl font-bold text-[var(--color-text)] mb-4 tracking-tight">{title}</h1>
      <p class="text-lg text-[var(--color-text-secondary)] mb-6 leading-relaxed">
        {description}
      </p>
      <TagList tags={tags} />
    </header>

    <!-- Divider -->
    <div class="h-px bg-gradient-to-r from-[var(--color-accent)]/30 via-[var(--color-border)] to-transparent mb-10"></div>

    {image && (
      <img
        src={image}
        alt={title}
        class="w-full rounded-xl mb-10 border border-[var(--color-border)]"
      />
    )}
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>
