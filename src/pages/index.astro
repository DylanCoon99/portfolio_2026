---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";
import { getCollection } from "astro:content";

const allProjects = await getCollection("projects");
const featuredProjects = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4);
---

<BaseLayout title="Dylan Coon — Software Engineer">
  <div class="max-w-5xl mx-auto px-6">
    <!-- Hero -->
    <section class="py-24 sm:py-32 relative">
      <!-- Gradient orb behind hero -->
      <div class="absolute -top-20 -left-20 w-72 h-72 bg-[var(--color-accent)]/8 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute top-10 right-0 w-56 h-56 bg-indigo-500/5 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col-reverse sm:flex-row sm:items-center sm:justify-between gap-10">
        <div>
          <p class="text-sm font-medium text-[var(--color-accent)] mb-4 tracking-wide uppercase">Software Engineer</p>
          <h1 class="text-4xl sm:text-6xl font-bold text-[var(--color-text)] mb-6 tracking-tight leading-[1.1]">
            Hey, I'm <span class="gradient-text">Dylan</span>.
          </h1>
          <p class="text-lg sm:text-xl text-[var(--color-text-secondary)] mb-10 max-w-xl leading-relaxed">
            I build backend systems, machine learning infrastructure, and tools that solve real problems.
          </p>
          <div class="flex gap-4">
            <a
              href="/projects"
              class="px-6 py-3 rounded-lg text-sm font-medium bg-[var(--color-accent)] text-white hover:shadow-[0_0_25px_var(--color-accent-glow)] hover:bg-[var(--color-accent-light)] transition-all"
            >
              View Projects
            </a>
            <a
              href="/about"
              class="px-6 py-3 rounded-lg text-sm font-medium border border-[var(--color-border)] text-[var(--color-text-secondary)] hover:border-[var(--color-accent)]/40 hover:text-[var(--color-text)] transition-all"
            >
              About Me
            </a>
          </div>
        </div>
        <div class="relative shrink-0">
          <div class="absolute -inset-1 rounded-full bg-gradient-to-br from-[var(--color-accent)] to-indigo-500 opacity-40 blur-md"></div>
          <img
            src="/profile_image.jpeg"
            alt="Dylan Coon"
            class="relative w-48 h-48 sm:w-64 sm:h-64 rounded-full object-cover border-2 border-[var(--color-border)]"
          />
        </div>
      </div>
    </section>

    <!-- Divider -->
    <div class="h-px bg-gradient-to-r from-transparent via-[var(--color-accent)]/30 to-transparent mb-16"></div>

    <!-- Featured Projects -->
    {featuredProjects.length > 0 && (
      <section class="pb-20">
        <div class="flex items-center justify-between mb-10">
          <h2 class="text-2xl font-semibold text-[var(--color-text)] tracking-tight">
            Featured Projects
          </h2>
          <a href="/projects" class="text-sm text-[var(--color-accent)] hover:text-[var(--color-accent-light)] transition-colors group">
            View all <span class="inline-block group-hover:translate-x-0.5 transition-transform">&rarr;</span>
          </a>
        </div>
        <div class="grid sm:grid-cols-2 gap-5">
          {featuredProjects.map((project) => (
            <ProjectCard
              title={project.data.title}
              description={project.data.description}
              tags={project.data.tags}
              slug={project.id}
              image={project.data.image}
            />
          ))}
        </div>
      </section>
    )}
  </div>
</BaseLayout>
